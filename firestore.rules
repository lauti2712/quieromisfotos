rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSuper() {
      return signedIn()
        && request.auth.token.email == 'lautarom87@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function userPath(id) { return /databases/$(database)/documents/users/$(id); }
    function isApproved() {
      return signedIn() && exists(userPath(uid())) && get(userPath(uid())).data.status == 'approved';
    }
    // Aprobado o pendiente de aprobación (no suspendido): puede armar su perfil y portfolio.
    function isActivePhotographer() {
      return signedIn() && exists(userPath(uid())) && get(userPath(uid())).data.status in ['approved', 'pending'];
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function slugOwnedAfter(id) {
      return getAfter(/databases/$(database)/documents/slugs/$(request.resource.data.slug)).data.uid == id;
    }
    function eventAfter(eid) { return getAfter(/databases/$(database)/documents/events/$(eid)).data; }
    function eventData(eid) { return get(/databases/$(database)/documents/events/$(eid)).data; }
    // ---------- configuración y etiquetas ----------
    match /settings/{id} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /tagTypes/{id} {
      allow read: if true;
      allow write: if isSuper();
    }
    match /tags/{id} {
      allow read: if true;
      allow write: if isSuper();
    }

    // ---------- slugs únicos de fotógrafos ----------
    match /slugs/{slug} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid'])
        && slug.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$');
      allow delete: if signedIn() && (resource.data.uid == uid() || isSuper());
    }

    // ---------- usuarios (perfil público si está aprobado) ----------
    match /users/{userId} {
      allow read: if (signedIn() && uid() == userId) || isSuper() || resource.data.status == 'approved';
      allow create: if signedIn() && uid() == userId && slugOwnedAfter(userId) && (
          (request.resource.data.role == 'photographer'
            && request.resource.data.status == 'pending'
            && request.resource.data.mpConnected == false
            // el plan, la cortesía, el dominio y MP los asignan el superadmin o el Worker, nunca el alta
            && !request.resource.data.keys().hasAny(['plan', 'proUntil', 'domainActive', 'siteDomain', 'trial', 'trialUsed', 'courtesy', 'demo'])
            && request.resource.data.get('mpUserId', null) == null)
          || (isSuper() && request.resource.data.role == 'superadmin'));
      allow update: if isSuper() || (signedIn() && uid() == userId
          && !changed().hasAny(['role', 'status', 'mpConnected', 'mpUserId', 'createdAt', 'plan', 'proUntil', 'domainActive', 'siteDomain', 'trial', 'trialUsed', 'courtesy'])
          && (!changed().hasAny(['slug']) || slugOwnedAfter(userId)));
      allow delete: if isSuper();
    }

    // Datos privados del usuario (email). Nunca públicos.
    match /userPrivate/{userId} {
      allow read, write: if (signedIn() && uid() == userId) || isSuper();
    }

    // ---------- eventos ----------
    match /events/{eid} {
      allow read: if resource.data.status == 'published'
        || isSuper()
        || (signedIn() && uid() in resource.data.photographerUids)
        || (signedIn() && resource.data.createdBy == uid())
        || (resource.data.openToJoin == true && isApproved());

      allow create: if (isSuper() && request.resource.data.kind == 'general')
        || (isApproved()
            && request.resource.data.kind == 'own'
            && request.resource.data.createdBy == uid()
            && request.resource.data.photographerUids == [uid()]);

      allow update: if isSuper()
        // el creador de un evento propio edita sus datos (no la membresía)
        || (isApproved() && resource.data.kind == 'own' && resource.data.createdBy == uid()
            && !changed().hasAny(['createdBy', 'kind', 'createdAt', 'photographerUids']))
        // sumarse a un evento abierto
        || (isApproved() && resource.data.openToJoin == true
            && changed().hasOnly(['photographerUids'])
            && !(uid() in resource.data.photographerUids)
            && request.resource.data.photographerUids.hasAll(resource.data.photographerUids)
            && request.resource.data.photographerUids.hasAll([uid()])
            && request.resource.data.photographerUids.size() == resource.data.photographerUids.size() + 1)
        // salir de un evento (no el creador)
        || (signedIn() && resource.data.createdBy != uid()
            && changed().hasOnly(['photographerUids'])
            && uid() in resource.data.photographerUids
            && resource.data.photographerUids.hasAll(request.resource.data.photographerUids)
            && !(uid() in request.resource.data.photographerUids)
            && request.resource.data.photographerUids.size() == resource.data.photographerUids.size() - 1);

      allow delete: if isSuper()
        || (isApproved() && resource.data.kind == 'own' && resource.data.createdBy == uid()
            && resource.data.photographerUids == [uid()]);

      // Set de cada fotógrafo dentro del evento (id = uid del fotógrafo)
      match /sets/{pid} {
        allow read: if true;
        // Contador de fotos, bytes, conteo por hora, vencimiento y ventas los escribe solo el Worker (tope del plan y retención).
        allow create: if isApproved() && uid() == pid
          && uid() in eventAfter(eid).photographerUids
          && request.resource.data.get('photoCount', 0) == 0
          && request.resource.data.get('bytesOriginal', 0) == 0
          && !request.resource.data.keys().hasAny(['bytesPublic', 'hourCounts', 'expiresAt', 'extendedUntil', 'originalsDeleted', 'extraPhotos', 'soldPhotos', 'soldOrders', 'bibScans', 'bibPhotos']);
        allow update: if isSuper() || (isApproved() && uid() == pid
          && !changed().hasAny(['photoCount', 'bytesOriginal', 'bytesPublic', 'hourCounts', 'expiresAt', 'extendedUntil', 'originalsDeleted', 'soldPhotos', 'soldOrders', 'storageAt', 'originalsDeletedAt', 'extraPhotos', 'bibScans', 'bibPhotos']));
        allow delete: if isSuper() || (signedIn() && uid() == pid && resource.data.get('photoCount', 0) == 0);
      }
    }

    // ---------- fotos (originalKey no se guarda: se deriva como e/{eventId}/{uid}/{photoId})
    match /photos/{pid} {
      allow read: if resource.data.hidden == false
        || (signedIn() && resource.data.photographerUid == uid())
        || isSuper();
      // Las crea y las borra el Worker (registra la subida y no deja borrar fotos vendidas).
      allow create: if isSuper();
      allow update: if isSuper()
        || (signedIn() && resource.data.photographerUid == uid() && changed().hasOnly(['subalbumId', 'hidden', 'bibs'])
            && (!changed().hasAny(['bibs']) || (request.resource.data.bibs is list && request.resource.data.bibs.size() <= 20)));
      allow delete: if isSuper();
    }

    // ---------- portfolio (fotos de muestra, no se venden)
    // Id = {uid}_{slot}; el slot tiene que ser menor al límite del plan (gratis / Pro).
    function portfolioLimit() {
      let u = get(userPath(uid())).data;
      let sp = /databases/$(database)/documents/settings/platform;
      let st = exists(sp) ? get(sp).data : {};
      let plan = u.get('plan', 'free');
      let paid = plan in ['lite', 'web', 'webdomain'] && u.get('proUntil', null) != null && u.proUntil > request.time;
      return !paid ? st.get('freePortfolioLimit', 12)
        : plan == 'lite' ? st.get('litePortfolioLimit', 30)
        : plan == 'web' ? st.get('webPortfolioLimit', 60)
        : st.get('webDomainPortfolioLimit', 100);
    }
    match /portfolio/{id} {
      allow read: if true;
      allow create: if isActivePhotographer()
        && request.resource.data.photographerUid == uid()
        && request.resource.data.slot is int
        && request.resource.data.slot >= 0
        && request.resource.data.slot < portfolioLimit()
        && id == uid() + '_' + string(request.resource.data.slot)
        && request.resource.data.thumbUrl.matches('.*/u/' + uid() + '/.*')
        && request.resource.data.url.matches('.*/u/' + uid() + '/.*')
        && (!('cleanUrl' in request.resource.data) || request.resource.data.cleanUrl.matches('.*/u/' + uid() + '/.*'));
      allow update: if signedIn() && resource.data.photographerUid == uid() && changed().hasOnly(['caption', 'order', 'album']);
      allow delete: if isSuper() || (signedIn() && resource.data.photographerUid == uid());
    }

    // ---------- pedidos de plan (el fotógrafo pide un plan; el superadmin lo activa)
    match /planRequests/{userId} {
      allow read: if isSuper() || (signedIn() && uid() == userId);
      allow create, update: if signedIn() && uid() == userId && isActivePhotographer()
        && request.resource.data.keys().hasOnly(['plan', 'domain', 'createdAt', 'displayName'])
        && request.resource.data.plan in ['lite', 'web', 'webdomain'];
      allow delete: if isSuper() || (signedIn() && uid() == userId);
    }

    // ---------- dominios propios activados (los da de alta el superadmin; los lee solo el Worker)
    // Resúmenes que escribe el Worker (uso de R2, etc.)
    match /adminStats/{id} {
      allow read: if isSuper();
      allow write: if false;
    }

    match /domains/{host} {
      allow read, write: if isSuper();
    }

    // ---------- órdenes y extensiones: solo las escribe el Worker ----------
    // Links cortos de los fotógrafos: quieromisfotos.com.ar/{alias} -> su álbum en un evento (Profesional y Premium).
    function canShortLink() {
      let u = get(userPath(uid())).data;
      let plan = u.get('plan', 'free');
      let paid = plan in ['web', 'webdomain'] && u.get('proUntil', null) != null && u.proUntil > request.time;
      return isSuper() || paid;
    }
    match /aliases/{alias} {
      allow read: if true;
      allow create: if isApproved() && canShortLink()
        && alias.matches('^[a-z0-9][a-z0-9-]{2,39}$')
        && !(alias in ['eventos', 'fotografos', 'terminos', 'privacidad', 'panel', 'demo', 'assets', 'js', 'css', 'api', 'admin', 'cuenta', 'carrito', 'calendario', 'soy-fotografo', 'index', 'sitemap', 'robots'])
        && request.resource.data.keys().hasOnly(['uid', 'eventId', 'createdAt'])
        && request.resource.data.uid == uid()
        && uid() in eventData(request.resource.data.eventId).photographerUids;
      allow delete: if isSuper() || (signedIn() && resource.data.uid == uid());
    }

    // Estadísticas anónimas (contadores, sin datos de quién visita). Cualquiera suma; solo de a una visita por escritura.
    match /stats/{sid} {
      allow read: if signedIn();
      allow create: if request.resource.data.keys().hasOnly(['views', 'days', 'src', 'pv', 'ca', 'updatedAt'])
        && request.resource.data.get('views', 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(['views', 'days', 'src', 'pv', 'ca', 'updatedAt'])
        && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 1
        && request.resource.data.get('views', 0) >= resource.data.get('views', 0);
    }

    // Datos del comprador de cada pedido: solo el superadmin y el comprador (el fotógrafo no).
    match /orderPrivate/{id} {
      allow read: if isSuper() || (signedIn() && resource.data.buyerUid == uid());
      allow write: if false;
    }
    match /orders/{id} {
      allow read: if isSuper() || (signedIn() && (resource.data.photographerUid == uid() || resource.data.buyerUid == uid()));
      allow write: if false;
    }
    // Avisos del público: eventos y fotógrafos que sigue cada usuario
    match /follows/{fid} {
      allow read, delete: if signedIn() && uid() == fid;
      allow create, update: if signedIn() && uid() == fid
        && request.resource.data.keys().hasOnly(['events', 'photographers', 'updatedAt'])
        && request.resource.data.get('events', []).size() <= 300
        && request.resource.data.get('photographers', []).size() <= 300;
    }

    // Clientes registrados (los escribe cada uno al ingresar; los lee el superadmin)
    match /customers/{cid} {
      allow read: if isSuper() || (signedIn() && uid() == cid);
      allow create, update: if signedIn() && uid() == cid
        && request.resource.data.keys().hasOnly(['name', 'email', 'provider', 'createdAt', 'lastLoginAt'])
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.lastLoginAt == request.time;
      allow delete: if isSuper();
    }

    // Suscripción del fotógrafo a un plan (la escribe el Worker con Mercado Pago)
    match /subscriptions/{uid} {
      allow read: if isSuper() || (signedIn() && uid() == uid);
      allow write: if false;
    }

    match /extensions/{id} {
      allow read: if isSuper() || (signedIn() && resource.data.photographerUid == uid());
      allow write: if false;
    }
  }
}
